FROM docker:27-cli

RUN apk add --no-cache nodejs git openssh-client bash

WORKDIR /workspace

COPY updater /opt/updater

ENV NODE_ENV=production
ENV PORT=3140

ENTRYPOINT ["/bin/sh", "-c", "if [ -f /workspace/updater/update-server.mjs ]; then exec node /workspace/updater/update-server.mjs; else exec node /opt/updater/update-server.mjs; fi"]
