# Docker deployment environment template

# Instance identity
COMPOSE_PROJECT_NAME=rizbill_app1
APP_INSTANCE_NAME=app1
PROXY_NETWORK_NAME=proxy-network
UPDATER_UID=1000
UPDATER_GID=1000
DOCKER_GID=999
UPDATER_SSH_DIR=/home/rizkitech/.ssh

# App runtime
NODE_ENV=production
APP_HOST=0.0.0.0
PORT=3002
AUTO_MIGRATE_ON_START=true
DISABLE_BACKGROUND_SERVICES=false
DISABLE_WHATSAPP=false
WA_SESSION_BASE_DIR=/app/whatsapp_sessions/app1

# App secrets and integrations
JWT_SECRET=replace_with_strong_secret
KIRIMDEV_WEBHOOK_SECRET=
KIRIMDEV_WEBHOOK_SECRET_PREVIOUS=
KIRIM_WEBHOOK_SECRET=
KIRIM_WEBHOOK_SECRET_PREVIOUS=
DIGIFLAZZ_WEBHOOK_SECRET=
API_KEY=
APP_UPDATE_SERVICE_URL=http://app-updater:3140
APP_UPDATE_TOKEN=
APP_UPDATE_REPO_URL=https://github.com/berbagibaik1202/rizbillsinglerouter.git
APP_UPDATE_GIT_BRANCH=release-push
APP_UPDATE_COMPOSE_FILE=docker-compose.vps.yml
APP_UPDATE_ENV_FILE=docker.env

# Database settings used by both app and MariaDB bootstrap
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=rizbill_app1
DB_USER=rizbill_app1
DB_PASSWORD=replace_with_db_password

MARIADB_ROOT_PASSWORD=replace_with_root_password
MARIADB_DATABASE=rizbill_app1
MARIADB_USER=rizbill_app1
MARIADB_PASSWORD=replace_with_db_password

# Optional services
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
